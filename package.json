{
  "name": "pickup-counter-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm --workspace=shared run build",
    "build": "npm --workspace=shared run build && npm --workspace=backend run build && npm --workspace=frontend run build",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run start:dev",
    "start": "npm --workspace=backend run start:prod",
    "test": "npm --workspace=backend run test",
    "test:watch": "npm --workspace=backend run test:watch",
    "test:cov": "npm --workspace=backend run test:cov",
    "send-webhook": "npm --workspace=backend run send-webhook --",
    "migrate": "npm --workspace=backend run migrate",
    "seed": "npm --workspace=backend run seed",
    "lint": "npm run lint --workspaces --if-present"
  }
}
